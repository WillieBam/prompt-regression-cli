# ------------------------------------------------------------------------------
# Active Provider Configuration (Default: Gemini)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Examples for other popular providers:
# ------------------------------------------------------------------------------

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Local / Self-Hosted (e.g. Ollama, vLLM, LocalAI) ---
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# --- DeepSeek ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# Multi-Provider Overrides (Optional)
# If you switch between providers via '--provider <name>', you can specify
# provider-specific environment variables:
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-3.5-flash-lite
#
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
